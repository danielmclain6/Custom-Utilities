<UserControl x:Class="CustomUtils.Utilities.Reminders.ReminderEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Text="New reminder"
                       FontSize="22" FontWeight="SemiBold"/>

            <!-- Title -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="Title" FontSize="12" Foreground="{StaticResource MutedFg}" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleBox" Padding="10,8" FontSize="14"/>
            </StackPanel>

            <!-- Note -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Note (optional)" FontSize="12" Foreground="{StaticResource MutedFg}" Margin="0,0,0,6"/>
                <TextBox x:Name="NoteBox" Padding="10,8" FontSize="13"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Date dropdowns -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="Date" FontSize="12" Foreground="{StaticResource MutedFg}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Year" FontSize="11" Foreground="{StaticResource MutedFg}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="YearCombo" Width="90" Padding="8,6" FontSize="14"
                                  SelectionChanged="DatePart_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Month" FontSize="11" Foreground="{StaticResource MutedFg}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="MonthCombo" Width="130" Padding="8,6" FontSize="14"
                                  SelectionChanged="DatePart_Changed"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Day" FontSize="11" Foreground="{StaticResource MutedFg}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DayCombo" Width="70" Padding="8,6" FontSize="14"
                                  SelectionChanged="DatePart_Changed"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Calendar (still available) -->
            <Border Grid.Row="4" Margin="0,12,0,0"
                    Background="{StaticResource CardBg}"
                    BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                    HorizontalAlignment="Left" Padding="6">
                <Calendar x:Name="DateCalendar" SelectedDatesChanged="DateCalendar_SelectedDatesChanged"/>
            </Border>

            <!-- Time dropdowns -->
            <StackPanel Grid.Row="5" Margin="0,16,0,0">
                <TextBlock Text="Time (24-hour)" FontSize="12" Foreground="{StaticResource MutedFg}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Hour" FontSize="11" Foreground="{StaticResource MutedFg}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="HourCombo" Width="80" Padding="8,6" FontSize="14"
                                  SelectionChanged="TimePart_Changed"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Minute" FontSize="11" Foreground="{StaticResource MutedFg}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="MinuteCombo" Width="80" Padding="8,6" FontSize="14"
                                  SelectionChanged="TimePart_Changed"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Validation error -->
            <TextBlock Grid.Row="6" x:Name="ErrorText"
                       Foreground="#FFD93838" FontSize="12" Margin="0,12,0,0"
                       Visibility="Collapsed"/>

            <!-- Actions -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
