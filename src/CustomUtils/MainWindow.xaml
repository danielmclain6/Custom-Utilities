<Window x:Class="CustomUtils.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Utilities"
        Height="640" Width="980"
        MinHeight="480" MinWidth="780"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="20,22,20,18">
                    <StackPanel>
                        <TextBlock Text="Custom Utilities"
                                   Foreground="{StaticResource SidebarFg}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Personal toolkit"
                                   Foreground="#FF8B95A1"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="UtilityList"
                         DockPanel.Dock="Top"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource SidebarFg}"
                         FontSize="13"
                         SelectionChanged="UtilityList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="Foreground" Value="#FFCBD2D9"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="reminders" IsSelected="True">Reminders</ListBoxItem>
                    <ListBoxItem Tag="settings">Settings</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="ContentHost" Grid.Column="1"/>
    </Grid>
</Window>
