<UserControl x:Class="CustomUtils.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Configure how Custom Utilities runs on your PC."
                   Foreground="{DynamicResource MutedFg}" FontSize="12" Margin="0,4,0,18"/>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6"
                Padding="16,14,16,14">
            <StackPanel>
                <CheckBox x:Name="AutoStartCheckBox" FontSize="14" FontWeight="SemiBold"
                          Content="Start with Windows" Checked="AutoStart_Toggled" Unchecked="AutoStart_Toggled"/>
                <TextBlock Text="When enabled, Custom Utilities launches silently to the system tray when you sign in. Reminders will fire on time without you opening the app."
                           Foreground="{DynamicResource MutedFg}" FontSize="12"
                           TextWrapping="Wrap" Margin="22,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6"
                Padding="16,14,16,14"
                Margin="0,12,0,0"
                VerticalAlignment="Top">
            <StackPanel>
                <CheckBox x:Name="DarkModeCheckBox" FontSize="14" FontWeight="SemiBold"
                          Content="Dark mode" Checked="DarkMode_Toggled" Unchecked="DarkMode_Toggled"/>
                <TextBlock Text="Use a dark color scheme throughout the app."
                           Foreground="{DynamicResource MutedFg}" FontSize="12"
                           TextWrapping="Wrap" Margin="22,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
